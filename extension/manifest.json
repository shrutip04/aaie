{
  "manifest_version": 3,
  "name": "AAIE - Attention & Action Intelligence Engine",
  "version": "1.0.0",
  "description": "Intelligent attention and notification management across Gmail, Discord, and WhatsApp",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "notifications",
    "identity",
    "alarms",
    "audio-capture"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentSignals.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "584688709989-u3204tcosaj132nh0fea4l5k9404ejqp.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify",
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["popup/*", "icons/*", "whatsappInjector.js"],
      "matches": ["https://web.whatsapp.com/*", "<all_urls>"]
    }
  ]
}