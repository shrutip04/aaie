# AAIE Backend Environment Variables
# Copy this to .env and fill in your values

PORT=3001

# Google OAuth2 credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/gmail/callback

# Discord (optional — only needed if using server-side Discord relay)
# Discord webhook URL for outgoing messages
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord bot token (if using bot instead of webhook)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
